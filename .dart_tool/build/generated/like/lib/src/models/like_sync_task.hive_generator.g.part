class LikeSyncTaskAdapter extends TypeAdapter<LikeSyncTask> {
  @override
  final int typeId = 1;

  @override
  LikeSyncTask read(BinaryReader reader) {
    final numOfFields = reader.readByte();
    final fields = <int, dynamic>{
      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
    };
    return LikeSyncTask(
      id: fields[0] as String,
      path: fields[1] as String,
      method: fields[2] as String,
      data: (fields[3] as Map?)?.cast<String, dynamic>(),
      queryParameters: (fields[4] as Map?)?.cast<String, dynamic>(),
      headers: (fields[5] as Map?)?.cast<String, dynamic>(),
      priorityIndex: fields[6] as int,
      createdAt: fields[7] as DateTime,
      retryCount: fields[8] as int,
    );
  }

  @override
  void write(BinaryWriter writer, LikeSyncTask obj) {
    writer
      ..writeByte(9)
      ..writeByte(0)
      ..write(obj.id)
      ..writeByte(1)
      ..write(obj.path)
      ..writeByte(2)
      ..write(obj.method)
      ..writeByte(3)
      ..write(obj.data)
      ..writeByte(4)
      ..write(obj.queryParameters)
      ..writeByte(5)
      ..write(obj.headers)
      ..writeByte(6)
      ..write(obj.priorityIndex)
      ..writeByte(7)
      ..write(obj.createdAt)
      ..writeByte(8)
      ..write(obj.retryCount);
  }

  @override
  int get hashCode => typeId.hashCode;

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is LikeSyncTaskAdapter &&
          runtimeType == other.runtimeType &&
          typeId == other.typeId;
}
